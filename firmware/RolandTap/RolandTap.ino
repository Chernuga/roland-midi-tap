/*
 * RolandTap -- ESP32-S3 USB-MIDI tap with WiFi telemetry
 *
 * Presents itself to a USB host (the phone) as a Roland Digital Piano
 * (VID 1410 / PID 0290) with a standard USB-MIDI class interface, then
 * streams every MIDI packet the host sends to a PC over TCP.
 *
 * Only ONE USB cable is ever connected (to the phone), so the board is
 * powered from the phone's OTG port -- no dual-VBUS risk.
 *
 * Requires secrets.h (generated by roland-tap.ps1 from config.json).
 */
#include "USB.h"
#include "USBMIDI.h"
#include <WiFi.h>

#if __has_include("secrets.h")
#include "secrets.h"
#else
#error "secrets.h missing -- run:  .\\roland-tap.ps1 config"
#endif

#ifndef PC_PORT
#define PC_PORT 5005
#endif

USBMIDI MIDI;
WiFiClient client;

struct Ev { uint32_t ms; uint8_t h, b1, b2, b3; };
static const int BUF_MAX = 512;
static Ev buf[BUF_MAX];
static int bufCount = 0;
static uint32_t dropped = 0;
static uint32_t t0;
static uint32_t sent = 0;
static uint32_t lastBeat = 0;

static void pushEv(const midiEventPacket_t &p) {
  if (bufCount < BUF_MAX) {
    buf[bufCount++] = { millis() - t0, p.header, p.byte1, p.byte2, p.byte3 };
  } else {
    dropped++;
  }
}

static void flushBuf() {
  for (int i = 0; i < bufCount; i++) {
    char line[80];
    snprintf(line, sizeof(line), "[%lu] RX %02X %02X %02X %02X\r\n",
             (unsigned long)buf[i].ms, buf[i].h, buf[i].b1, buf[i].b2, buf[i].b3);
    client.print(line);
    sent++;
  }
  if (dropped) {
    client.printf("[----] dropped %lu events (buffer full)\r\n", (unsigned long)dropped);
    dropped = 0;
  }
  bufCount = 0;
}

void setup() {
  USB.VID(0x1410);
  USB.PID(0x0290);
  USB.manufacturerName("Roland");
  USB.productName("Roland Digital Piano");
  USB.serialNumber("RDP000001");

  MIDI.begin();
  USB.begin();          // device is up immediately; host may connect at once

  t0 = millis();

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
}

void loop() {
  static bool everConnected = false;

  if (WiFi.status() == WL_CONNECTED && !client.connected()) {
    client.connect(PC_HOST, PC_PORT);
    if (client.connected()) {
      if (!everConnected) {
        client.printf("[----] RolandTap online, ip=%s\r\n",
                      WiFi.localIP().toString().c_str());
        everConnected = true;
      } else {
        client.printf("[----] reconnect\r\n");
      }
      flushBuf();
    }
  }

  midiEventPacket_t pkt;
  while (MIDI.readPacket(&pkt)) {
    if (client.connected()) {
      char line[80];
      snprintf(line, sizeof(line), "[%lu] RX %02X %02X %02X %02X\r\n",
               (unsigned long)(millis() - t0), pkt.header,
               pkt.byte1, pkt.byte2, pkt.byte3);
      client.print(line);
      sent++;
    } else {
      pushEv(pkt);
    }
  }

  if (millis() - lastBeat >= 5000) {
    lastBeat = millis();
    if (client.connected()) {
      client.printf("[%lu] alive sent=%lu buffered=%d wifi=%d\r\n",
                    (unsigned long)(millis() - t0), (unsigned long)sent,
                    bufCount, (int)WiFi.status());
    }
  }

  delay(1);
}
